
# Server port the Node server listens on
PORT=5000

# Postgres connection URL used by Drizzle / database migrations
# Example: postgres://user:pass@localhost:5432/dbname
DATABASE_URL=

# Gmail account used for sending/receiving (used by IMAP sync examples)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Gemini / LLM API key (or other model provider key)
GEMINI_API_KEY=

# Elasticsearch connection URL (if using Elasticsearch)
ELASTICSEARCH_URL=

# Qdrant vector DB URL and API key (if using Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Slack webhook and API token for notifications
SLACK_WEBHOOK_URL=
SLACK_API_TOKEN=

# Publicly reachable site URL used for webhook generation
WEBHOOK_SITE_URL=

# REPL ID used by Replit dev plugins (optional)
REPL_ID=

# NODE_ENV can be set to 'development' or 'production'
NODE_ENV=development
