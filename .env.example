### Environment example file for the project "ones".
# Copy this file to `.env` and fill in real values for local development.

# Server
PORT=5000                     # Port the server will listen on (default: 5000)

# Database (used by drizzle / migrations)
# Example: postgres://user:password@localhost:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/ones_db

# Gmail auto-add (optional)
# If set, the server will auto-add this Gmail account on startup.
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Google Gemini / Generative AI API key
# Provide your Gemini API key to enable AI features (categorization, embeddings, replies).
GEMINI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Elasticsearch (optional)
# Example: http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200

# Qdrant (optional) - vector DB for RAG
# Example: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Slack webhook for notifications (optional)
# Example: https://hooks.slack.com/services/AAA/BBB/CCC
SLACK_WEBHOOK_URL=

# External webhook receiver to be notified when an "Interested" email is found (optional)
# Example: https://hooks.example.com/email
WEBHOOK_SITE_URL=

# Replit specific ID (optional) used in vite config for dev plugins
REPL_ID=

# MongoDB (optional)
# Example: mongodb+srv://user:password@cluster0.yourcluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# Qdrant service token (optional)
# If your Qdrant provider requires a token, set it here. Do NOT commit real tokens.
QDRANT_API_KEY=

# External webhook receiver (optional)
# Example: https://webhook.site/886f9fb7-fb53-4574-82f6-85b7a04ddf7b
WEBHOOK_SITE_URL=

# Slack API token (optional)
# Example: xoxb-XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_API_TOKEN=
